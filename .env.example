# ── Database ────────────────────────────────────────────────────────────────
# Local dev (embedded PG dev server uses port 54329; docker-compose uses 5432)
DATABASE_URL=postgresql://sanchari:sanchari@localhost:54329/sanchari

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ char random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=sanchari_session
SESSION_TTL_HOURS=168

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (optional — mock provider used when unset, clearly labeled in UI) ────
AI_PROVIDER=mock
# AI_PROVIDER=openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Monthly USD soft cap for AI spend; gateway blocks paid calls beyond it
AI_MONTHLY_BUDGET_USD=25

# ── Weather (Open-Meteo is keyless/free; set MOCK_WEATHER=1 to force mock) ──
MOCK_WEATHER=0

# ── Maps / Routing (OSM tiles are keyless; OSRM public demo used with timeout)
NEXT_PUBLIC_MAP_PROVIDER=osm
ROUTING_PROVIDER=osrm

# ── Payments (sandbox provider used when keys absent) ───────────────────────
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Email / SMS / Push (console transport when unset) ───────────────────────
EMAIL_PROVIDER=console
SMTP_URL=
SMS_PROVIDER=console

# ── Object storage (S3-compatible; local/public URLs used when unset) ───────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
